{
    "name": "antigravity/laravel-otel",
    "description": "Laravel integration for OpenTelemetry with dual exporters (Jaeger & Zipkin) using JSON protocol",
    "type": "library",
    "keywords": [
        "laravel",
        "opentelemetry",
        "tracing",
        "observability",
        "jaeger",
        "zipkin",
        "monitoring",
        "apm"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Antigravity",
            "email": "dev@antigravity.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "open-telemetry/sdk": "^1.0",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/exporter-zipkin": "^1.0",
        "open-telemetry/opentelemetry-auto-laravel": "^0.0",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Antigravity\\LaravelOtel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Antigravity\\LaravelOtel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Antigravity\\LaravelOtel\\OpenTelemetryServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
